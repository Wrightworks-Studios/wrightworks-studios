---
interface Link {
	label: string;
	href: string;
	primary?: boolean;
}

interface Props {
	id: string;
	name: string;
	icon: string;
	status: string;
	tagline: string;
	platforms: string[];
	image: { src: string; alt: string; width: number; height: number };
	links: Link[];
	flip?: boolean;
}

const { id, name, icon, status, tagline, platforms, image, links, flip = false } = Astro.props;
---

<article class:list={['product', { flip }]} id={id} aria-labelledby={`${id}-name`}>
	<div class="copy">
		<div class="title-row">
			<img class="icon" src={icon} alt="" width="80" height="80" loading="lazy" />
			<div>
				<h3 id={`${id}-name`}>{name}</h3>
				<p class="status">{status}</p>
			</div>
		</div>
		<p class="tagline">{tagline}</p>
		<div class="body"><slot /></div>
		<ul class="platforms" aria-label="Runs on">
			{platforms.map((platform) => <li>{platform}</li>)}
		</ul>
		<div class="links">
			{
				links.map((link) => (
					<a class:list={['button', link.primary ? 'primary' : 'secondary']} href={link.href}>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
	<figure class="media">
		<img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
	</figure>
</article>

<style>
	.product {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		gap: 56px;
		align-items: center;
		padding: 56px 0;
		border-top: 1px solid var(--line);
	}

	.product.flip .copy {
		order: 2;
	}

	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 64px;
		height: 64px;
		border-radius: 15px;
		box-shadow: 0 6px 16px rgba(11, 34, 64, 0.18);
		outline: 1px solid var(--line);
	}

	h3 {
		font-size: 32px;
	}

	.status {
		display: inline-block;
		margin-top: 8px;
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--pill-bg);
		color: var(--ink);
		font-size: 13px;
		font-weight: 600;
	}

	.tagline {
		margin-top: 24px;
		font-family: var(--serif);
		font-size: 22px;
		line-height: 1.3;
		color: var(--ink);
	}

	.body {
		margin-top: 12px;
		display: grid;
		gap: 12px;
	}

	.platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
		color: var(--muted);
		font-size: 13px;
		font-weight: 500;
	}

	.platforms li {
		padding: 2px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	.media {
		margin: 0;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		background: var(--surface);
	}

	.media img {
		width: 100%;
		height: auto;
	}

	@media (max-width: 860px) {
		.product {
			grid-template-columns: 1fr;
			gap: 28px;
			padding: 40px 0;
		}

		.product.flip .copy {
			order: 0;
		}

		h3 {
			font-size: 28px;
		}
	}
</style>
