---
import Lockup from '../components/Lockup.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Wrightworks Studios',
	description = 'Wrightworks Studios is an independent software studio. We make Pixie, ForgetMeNote and My Training Max: native apps for Apple devices and self-hosted tools that keep your data yours.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
const year = 2026;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#FCF3E5" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0A1A2F" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Wrightworks Studios" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The Wrightworks Studios logo: a schooner on a wave beside the name" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" href="/fonts/Fraunces.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Onest.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip" href="#content">Skip to content</a>
		<header class="site-header">
			<div class="wrap header-inner">
				<a class="home" href="/" aria-label="Wrightworks Studios home"><Lockup /></a>
				<nav aria-label="Main">
					<a href="/#apps">Apps</a>
					<a href="/#principles">How we work</a>
					<a href="/#contact">Contact</a>
				</nav>
			</div>
		</header>
		<main id="content">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div class="footer-brand">
					<Lockup size="small" />
					<p>Independent software for Apple devices and your own server.</p>
				</div>
				<nav class="footer-links" aria-label="Our apps">
					<h2>Apps</h2>
					<a href="https://pixieplayer.app">Pixie</a>
					<a href="https://forgetmenote.app">ForgetMeNote</a>
					<a href="https://mytrainingmax.app">My Training Max</a>
				</nav>
				<nav class="footer-links" aria-label="Contact">
					<h2>Contact</h2>
					<a href="mailto:support@wrightworksstudios.com">support@wrightworksstudios.com</a>
				</nav>
			</div>
			<div class="wrap fine-print">
				<p>
					Pixie is an independent app and is not affiliated with, endorsed by, or sponsored by Plex,
					Jellyfin, Navidrome, or Audiobookshelf. Apple, iPhone, iPad, Mac, Apple TV, Apple Watch and
					CarPlay are trademarks of Apple Inc.
				</p>
				<p>© {year} Wrightworks Studios LLC</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Fraunces';
		src: url('/fonts/Fraunces.woff2') format('woff2');
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
	}

	@font-face {
		font-family: 'Onest';
		src: url('/fonts/Onest.woff2') format('woff2');
		font-style: normal;
		font-weight: 100 900;
		font-display: swap;
	}

	:root {
		color-scheme: light dark;
		--bg: #fcf3e5;
		--bg-deep: #f5e8d3;
		--surface: #fffaf2;
		--ink: #0b2240;
		--text: #1d2b40;
		--muted: #56637a;
		--line: rgba(11, 34, 64, 0.14);
		--link: #1f4f86;
		--pill-bg: rgba(11, 34, 64, 0.07);
		--button-bg: #0b2240;
		--button-text: #fcf3e5;
		--shadow: 0 18px 48px rgba(11, 34, 64, 0.12);
		--serif: 'Fraunces', 'Iowan Old Style', Georgia, serif;
		--sans: 'Onest', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
		--wrap: 1120px;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0a1a2f;
			--bg-deep: #081526;
			--surface: #10243d;
			--ink: #fcf3e5;
			--text: #e9e1d3;
			--muted: #a7b2c1;
			--line: rgba(252, 243, 229, 0.14);
			--link: #9cc6f0;
			--pill-bg: rgba(252, 243, 229, 0.08);
			--button-bg: #fcf3e5;
			--button-text: #0b2240;
			--shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		min-width: 320px;
		background: var(--bg);
		color: var(--text);
		font: 400 17px/1.6 var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	img,
	svg {
		display: block;
		max-width: 100%;
	}

	a {
		color: var(--link);
		text-underline-offset: 3px;
	}

	h1,
	h2,
	h3 {
		color: var(--ink);
		font-family: var(--serif);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		margin: 0;
	}

	p {
		margin: 0;
	}

	::selection {
		background: rgba(31, 79, 134, 0.25);
	}

	:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 3px;
		border-radius: 4px;
	}

	[id] {
		scroll-margin-top: 88px;
	}

	.wrap {
		width: min(var(--wrap), calc(100% - 32px));
		margin: 0 auto;
	}

	.skip {
		position: absolute;
		left: 16px;
		top: -48px;
		padding: 8px 12px;
		background: var(--button-bg);
		color: var(--button-text);
		border-radius: 8px;
		z-index: 10;
	}

	.skip:focus {
		top: 12px;
	}

	.eyebrow {
		color: var(--muted);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0 20px;
		border-radius: 999px;
		border: 1px solid var(--ink);
		font-weight: 600;
		font-size: 16px;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.15s ease, background-color 0.15s ease;
	}

	.button.primary {
		background: var(--button-bg);
		color: var(--button-text);
		border-color: var(--button-bg);
	}

	.button.secondary {
		color: var(--ink);
		background: transparent;
	}

	.button:hover {
		transform: translateY(-1px);
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		.button {
			transition: none;
		}

		.button:hover {
			transform: none;
		}
	}
</style>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: saturate(1.4) blur(14px);
		-webkit-backdrop-filter: saturate(1.4) blur(14px);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 72px;
	}

	.home {
		color: var(--ink);
		text-decoration: none;
	}

	.site-header nav {
		display: flex;
		gap: 24px;
	}

	.site-header nav a {
		color: var(--ink);
		font-weight: 500;
		font-size: 15px;
		text-decoration: none;
	}

	.site-header nav a:hover {
		text-decoration: underline;
	}

	@media (max-width: 640px) {
		.site-header nav {
			gap: 14px;
		}

		.site-header nav a {
			font-size: 14px;
		}
	}

	@media (max-width: 420px) {
		.site-header nav a[href='/#principles'] {
			display: none;
		}
	}

	.site-footer {
		margin-top: 96px;
		padding: 56px 0 40px;
		background: var(--bg-deep);
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 15px;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1.4fr;
		gap: 32px;
	}

	.footer-brand {
		color: var(--ink);
	}

	.footer-brand p {
		margin-top: 14px;
		color: var(--muted);
		max-width: 32ch;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.footer-links h2 {
		font-family: var(--sans);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 4px;
	}

	.footer-links a {
		color: var(--ink);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.footer-links a:hover {
		text-decoration: underline;
	}

	.fine-print {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
		display: grid;
		gap: 8px;
		font-size: 13px;
	}

	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}
	}
</style>
