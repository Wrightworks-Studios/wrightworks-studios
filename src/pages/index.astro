---
import Layout from '../layouts/Layout.astro';
import Product from '../components/Product.astro';
import Ship from '../assets/ship.svg';
---

<Layout>
	<section class="hero wrap" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="eyebrow">Independent software studio</p>
			<h1 id="hero-title">Software that respects the people who use it.</h1>
			<p class="lede">
				Wrightworks Studios makes native apps for iPhone, iPad, Mac, Apple TV and Apple Watch, and
				self-hosted tools that keep your data on hardware you control. No ad networks, no tracking,
				and no account with us that you don't need.
			</p>
			<div class="actions">
				<a class="button primary" href="#apps">See our apps</a>
				<a class="button secondary" href="#contact">Work with us</a>
			</div>
			<ul class="app-row" aria-label="Our apps">
				<li>
					<a href="#pixie"><img src="/images/pixie-icon.webp" alt="" width="80" height="80" />Pixie</a>
				</li>
				<li>
					<a href="#forgetmenote"
						><img src="/images/forgetmenote-icon.webp" alt="" width="80" height="80" />ForgetMeNote</a
					>
				</li>
				<li>
					<a href="#mytrainingmax"
						><img src="/images/mytrainingmax-icon.webp" alt="" width="80" height="80" />My Training Max</a
					>
				</li>
			</ul>
		</div>
		<div class="hero-art" aria-hidden="true">
			<Ship class="hero-ship" />
		</div>
	</section>

	<section class="apps wrap" id="apps" aria-labelledby="apps-title">
		<div class="section-head">
			<p class="eyebrow">Our apps</p>
			<h2 id="apps-title">Three apps, made the same careful way.</h2>
			<p>
				A music and audiobook player for your own server, a shared notebook for people and AI, and
				a strength-training log that does the maths for you.
			</p>
		</div>

		<Product
			id="pixie"
			name="Pixie"
			icon="/images/pixie-icon.webp"
			status="Public beta on TestFlight"
			tagline="Music and audiobooks from your own server."
			platforms={['iPhone', 'iPad', 'Mac', 'Apple TV', 'Apple Watch', 'CarPlay']}
			image={{
				src: '/images/pixie.webp',
				width: 1200,
				height: 750,
				alt: 'Pixie on the Mac playing an album, with large cover art and a waveform scrubber',
			}}
			links={[
				{ label: 'Join the beta', href: 'https://testflight.apple.com/join/Sq9BU6pq', primary: true },
				{ label: 'pixieplayer.app', href: 'https://pixieplayer.app' },
			]}
		>
			<p>
				Pixie plays your Plex, Jellyfin, Navidrome or Audiobookshelf library, streaming straight from
				your server with nothing of ours in between. Downloads for offline listening, audiobook
				bookmarks and CarPlay are all there, and your settings and listening history sync through
				your own iCloud.
			</p>
			<p>There's no Pixie account to make, and no ad or analytics code inside.</p>
		</Product>

		<Product
			id="forgetmenote"
			name="ForgetMeNote"
			icon="/images/forgetmenote-icon.webp"
			status="Source available · self-hosted"
			tagline="Self-hosted notebooks for people and AI."
			platforms={['Web', 'Your own server', 'MCP for AI tools']}
			image={{
				src: '/images/forgetmenote.webp',
				width: 1200,
				height: 750,
				alt: 'The ForgetMeNote editor showing a Markdown note with headings, lists and a table',
			}}
			links={[
				{ label: 'forgetmenote.app', href: 'https://forgetmenote.app', primary: true },
				{ label: 'View on GitHub', href: 'https://github.com/Wrightworks-Studios/forgetmenote' },
			]}
			flip
		>
			<p>
				Write in Markdown, keep every version in Git and edit together in real time. A built-in MCP
				server lets AI assistants search, read and edit the same notes, under the same roles and
				permissions as everyone else in the notebook.
			</p>
			<p>
				It runs as one Go binary with Postgres, and every notebook exports as an ordinary Git
				repository you can keep without us.
			</p>
		</Product>

		<Product
			id="mytrainingmax"
			name="My Training Max"
			icon="/images/mytrainingmax-icon.webp"
			status="Coming soon to the App Store"
			tagline="Your whole cycle, worked out."
			platforms={['iPhone', 'iPad', 'Apple Watch']}
			image={{
				src: '/images/mytrainingmax.webp',
				width: 1200,
				height: 750,
				alt: 'Three iPhone screens from My Training Max: the cycle overview, a bench workout with plates per side, and strength for bodyweight',
			}}
			links={[{ label: 'mytrainingmax.app', href: 'https://mytrainingmax.app', primary: true }]}
		>
			<p>
				A strength-training log for barbell programs built on training maxes. Enter one number per
				lift, pick a template, and every set of the cycle is laid out with the weight rounded to
				your plates and the plates to load.
			</p>
			<p>
				A rest timer on the Lock Screen, an Apple Watch app, more than 150 templates you can edit as
				plain CSV files, and no account. One price, everything included.
			</p>
		</Product>
	</section>

	<section class="principles" id="principles" aria-labelledby="principles-title">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">How we work</p>
				<h2 id="principles-title">What every Wrightworks app has in common.</h2>
			</div>
			<div class="grid">
				<div class="principle">
					<h3>Your data stays yours</h3>
					<p>
						No accounts with us, no advertising or analytics code, no tracking. Your data lives on your
						devices, in your own iCloud or on your own server.
					</p>
				</div>
				<div class="principle">
					<h3>Native to the platform</h3>
					<p>
						Swift and SwiftUI on Apple devices, with the widgets, Lock Screen, Apple Watch and CarPlay
						support people expect. On the server, a single binary that's easy to run.
					</p>
				</div>
				<div class="principle">
					<h3>Formats you can open</h3>
					<p>
						Workout templates are CSV files, notes are Markdown in Git, and your music stays in your own
						library. Nothing is locked in.
					</p>
				</div>
				<div class="principle">
					<h3>Small and independent</h3>
					<p>
						A few products, each built carefully and looked after. No dark patterns, no nagging
						upsells and no surprises in the fine print.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="contact wrap" id="contact" aria-labelledby="contact-title">
		<div class="contact-card">
			<div>
				<p class="eyebrow">Work with us</p>
				<h2 id="contact-title">Building something for Apple devices?</h2>
				<p>
					Alongside our own apps, we take on a small number of client projects: new apps for iPhone,
					iPad, Mac and Apple Watch, bringing an existing app to more Apple devices, and untangling
					code that has grown hard to change.
				</p>
				<p class="support-note">
					Need help with one of our apps? Write to
					<a href="mailto:support@pixieplayer.app">support@pixieplayer.app</a> or
					<a href="mailto:support@mytrainingmax.app">support@mytrainingmax.app</a>, or open an issue
					on <a href="https://github.com/Wrightworks-Studios/forgetmenote">ForgetMeNote's GitHub</a>.
				</p>
			</div>
			<a class="button primary" href="mailto:support@wrightworksstudios.com">Email the studio</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 48px;
		align-items: center;
		padding: 88px 0 72px;
	}

	h1 {
		margin-top: 16px;
		font-size: clamp(40px, 6vw, 68px);
		font-weight: 750;
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.lede {
		margin-top: 24px;
		max-width: 56ch;
		font-size: 19px;
		color: var(--text);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.app-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 24px;
		margin: 40px 0 0;
		padding: 0;
		list-style: none;
	}

	.app-row a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
	}

	.app-row a:hover {
		text-decoration: underline;
	}

	.app-row img {
		width: 36px;
		height: 36px;
		border-radius: 9px;
		outline: 1px solid var(--line);
	}

	.hero-art {
		color: var(--ink);
		display: flex;
		justify-content: center;
	}

	.hero-art :global(.hero-ship) {
		width: min(100%, 400px);
		height: auto;
		opacity: 0.95;
	}

	.section-head {
		max-width: 680px;
	}

	.section-head h2 {
		margin-top: 12px;
		font-size: clamp(30px, 4vw, 44px);
		text-wrap: balance;
	}

	.section-head p:not(.eyebrow) {
		margin-top: 16px;
		color: var(--muted);
		font-size: 18px;
	}

	.apps {
		padding-top: 40px;
	}

	.apps .section-head {
		margin-bottom: 48px;
	}

	.principles {
		margin-top: 56px;
		padding: 88px 0;
		background: var(--bg-deep);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 32px;
		margin-top: 48px;
	}

	.principle {
		padding-top: 20px;
		border-top: 2px solid var(--ink);
	}

	.principle h3 {
		font-size: 22px;
	}

	.principle p {
		margin-top: 12px;
		color: var(--muted);
	}

	.contact {
		padding-top: 96px;
	}

	.contact-card {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		padding: 48px;
		border-radius: 24px;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
	}

	.contact-card h2 {
		margin-top: 12px;
		font-size: clamp(28px, 3.6vw, 40px);
	}

	.contact-card p:not(.eyebrow) {
		margin-top: 16px;
		max-width: 60ch;
	}

	.contact-card .support-note {
		color: var(--muted);
		font-size: 15px;
	}

	@media (max-width: 960px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 56px 0 48px;
		}

		.hero-art {
			display: none;
		}

		.contact-card {
			flex-direction: column;
			align-items: flex-start;
			padding: 32px 24px;
		}
	}

	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.principles {
			padding: 64px 0;
		}

		.lede {
			font-size: 18px;
		}
	}
</style>
